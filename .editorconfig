# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 120

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 0

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.iss]
indent_size = 2
end_of_line = crlf
